  "components": {
    "schemas": {
      "ActingAsResponse": {
        "required": [
          "actingAsPlayerId"
        ],
        "type": "object",
        "properties": {
          "actingAsPlayerId": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "AdjustmentIdResponse": {
        "required": [
          "id"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "AdminDeleteRequest": {
        "required": [
          "reason"
        ],
        "type": "object",
        "properties": {
          "reason": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "LogRequest": {
        "required": [
          "targetPlayerId",
          "delta",
          "reason"
        ],
        "type": "object",
        "properties": {
          "targetPlayerId": {
            "type": "string"
          },
          "delta": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "reason": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "MyRatingResponse": {
        "required": [
          "score"
        ],
        "type": "object",
        "properties": {
          "score": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "RatingIdResponse": {
        "required": [
          "id"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
