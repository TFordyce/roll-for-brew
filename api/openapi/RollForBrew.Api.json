  "components": {
    "schemas": {
      "ActingAsResponse": {
        "required": [
          "actingAsPlayerId"
        ],
        "type": "object",
        "properties": {
          "actingAsPlayerId": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "EnterRoomResponse": {
        "required": [
          "roomId"
        ],
        "type": "object",
        "properties": {
          "roomId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "MyRatingResponse": {
        "required": [
          "score"
        ],
        "type": "object",
        "properties": {
          "score": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "OrderResponse": {
        "required": [
          "drinkType"
        ],
        "type": "object",
        "properties": {
          "drinkType": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
